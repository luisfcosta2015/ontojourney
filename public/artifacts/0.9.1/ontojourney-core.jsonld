    {
      "@id": "https://w3id.org/ontojourney/core#MissionSpecification",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Normative Description that states what the Learner is invited or expected to pursue within an HLJ stage and may combine a desired result with directions for action."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "MissionSpecification"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#NormativeDescription"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#NarrativeJourneyExecution",
      "@type": [
        "gufo:EventType",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Journey Execution of a Narrative Journey Model in which the performed stages enact a narratively organised journey."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "NarrativeJourneyExecution"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#JourneyExecution"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#Description",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "An Information Object that expresses a conceptualization of entities or configurations and provides criteria for interpreting or assessing them."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Description"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#InformationObject"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#PlanDescription",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Normative Description that prescribes or organises intended actions and events towards a purpose."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "PlanDescription"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#NormativeDescription"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#directlyPrecedesStage",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "https://w3id.org/ontojourney/core#StageSpecification"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "directlyPrecedesStage"
      },
      "rdfs:range": {
        "@id": "https://w3id.org/ontojourney/core#StageSpecification"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#JourneyNarrative",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Narrative Content that organises the narrative progression of a Narrative Journey Model as a whole."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "JourneyNarrative"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#NarrativeContent"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#StageSpecification",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Plan Description that specifies one stage belonging to a Journey Model and may be linked to other Stage Specifications through directlyPrecedesStage."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "StageSpecification"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#PlanDescription"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#ClosureSpecification",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Condition Description defined by a Journey Model that states the condition under which an execution of the model counts as having reached closure."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "ClosureSpecification"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#ConditionDescription"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core",
      "@type": "owl:Ontology",
      "dcterms:creator": "Luis Felipe Coimbra Costa",
      "dcterms:description": {
        "@language": "en",
        "@value": "A reference ontology for narrative-heroic learning journeys, modeled in OntoUML and grounded in UFO."
      },
      "dcterms:issued": {
        "@type": "xsd:date",
        "@value": "2026-08-21"
      },
      "dcterms:license": {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      },
      "dcterms:modified": {
        "@type": "xsd:date",
        "@value": "2026-08-21"
      },
      "dcterms:title": {
        "@language": "en",
        "@value": "OntoJourney Core"
      },
      "owl:imports": {
        "@id": "gufo:"
      },
      "owl:priorVersion": {
        "@id": "https://w3id.org/ontojourney/core/0.9"
      },
      "owl:versionIRI": {
        "@id": "https://w3id.org/ontojourney/core/0.9.1"
      },
      "owl:versionInfo": "0.9.1",
      "vann:preferredNamespacePrefix": "oj",
      "vann:preferredNamespaceUri": "https://w3id.org/ontojourney/core#"
    },
    {
      "@id": "https://w3id.org/ontojourney/core#StageExecution",
      "@type": [
        "gufo:EventType",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "An event within a Journey Execution that enacts one Stage Specification belonging to the executed Journey Model."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "StageExecution"
      },
      "rdfs:subClassOf": {
        "@id": "gufo:Event"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#isTransformationOf",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "https://w3id.org/ontojourney/core#RealizedTransformation"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "isTransformationOf"
      },
      "rdfs:range": {
        "@id": "https://w3id.org/ontojourney/core#Person"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#hasEducationalPurpose",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "https://w3id.org/ontojourney/core#LearningJourneyModel"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "hasEducationalPurpose"
      },
      "rdfs:range": {
        "@id": "https://w3id.org/ontojourney/core#EducationalPurpose"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#ChallengeEncounter",
      "@type": [
        "gufo:EventType",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "An event within an HLJ Stage Execution in which the specified challenge of that stage is faced, whether or not it is successfully addressed."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "ChallengeEncounter"
      },
      "rdfs:subClassOf": {
        "@id": "gufo:Event"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#HeroicNarrativeJourneyModel",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Narrative Journey Model that frames a meaningful progression through demanding stages towards transformation and closure as a heroic trajectory."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "HeroicNarrativeJourneyModel"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#NarrativeJourneyModel"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#JourneyExecution",
      "@type": [
        "gufo:EventType",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A complex event in which one Journey Model is enacted in a particular context through one or more Stage Executions."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "JourneyExecution"
      },
      "rdfs:subClassOf": {
        "@id": "gufo:Event"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#hasStageExecution",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "https://w3id.org/ontojourney/core#JourneyExecution"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "hasStageExecution"
      },
      "rdfs:range": {
        "@id": "https://w3id.org/ontojourney/core#StageExecution"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#Protagonist",
      "@type": [
        "gufo:Role",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A historical role instantiated by a Person through participation as the focal subject of a Heroic Narrative Journey Execution."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Protagonist"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#Person"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#TransformationEvent",
      "@type": [
        "gufo:EventType",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "An event within a Journey Execution that brings about one Realized Transformation."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "TransformationEvent"
      },
      "rdfs:subClassOf": {
        "@id": "gufo:Event"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#hasChallenge",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "https://w3id.org/ontojourney/core#StageSpecification"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "hasChallenge"
      },
      "rdfs:range": {
        "@id": "https://w3id.org/ontojourney/core#ChallengeSpecification"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#ChallengeSpecification",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Normative Description assigned to a Stage Specification that describes a demand, obstacle, problem, task, or condition that makes progression demanding."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "ChallengeSpecification"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#NormativeDescription"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#NarrativeJourneyModel",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Journey Model whose overall progression is organised by exactly one Journey Narrative."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "NarrativeJourneyModel"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#JourneyModel"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#LearningJourneyModel",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Journey Model and Plan Description that intentionally organises an educational experience and has at least one Educational Purpose."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "LearningJourneyModel"
      },
      "rdfs:subClassOf": [
        {
          "@id": "https://w3id.org/ontojourney/core#JourneyModel"
        },
        {
          "@id": "https://w3id.org/ontojourney/core#PlanDescription"
        }
      ]
    },
    {
      "@id": "https://w3id.org/ontojourney/core#AssistanceProvision",
      "@type": [
        "gufo:EventType",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "An event within an HLJ Stage Execution in which assistance specified for that stage is provided."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "AssistanceProvision"
      },
      "rdfs:subClassOf": {
        "@id": "gufo:Event"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#hasAssistance",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "https://w3id.org/ontojourney/core#HLJStageSpecification"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "hasAssistance"
      },
      "rdfs:range": {
        "@id": "https://w3id.org/ontojourney/core#AssistanceSpecification"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#definesClosure",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "https://w3id.org/ontojourney/core#JourneyModel"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "definesClosure"
      },
      "rdfs:range": {
        "@id": "https://w3id.org/ontojourney/core#ClosureSpecification"
