    {
      "@id": "https://w3id.org/ontojourney/core#RealizedTransformation",
      "@type": [
        "gufo:SituationType",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A situation brought about by one or more Transformation Events that represents an actual change concerning exactly one Person and satisfies one Intended Transformation."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "RealizedTransformation"
      },
      "rdfs:subClassOf": {
        "@id": "gufo:Situation"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#NarrativeFraming",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "Narrative Content that gives one HLJ Stage Specification its local narrative context and connects it to the wider journey."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "NarrativeFraming"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#NarrativeContent"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#AssistanceSpecification",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Normative Description of support intended to be made available within an HLJ Stage Specification."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "AssistanceSpecification"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#NormativeDescription"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#HeroicNarrativeJourneyExecution",
      "@type": [
        "gufo:EventType",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Narrative Journey Execution of a Heroic Narrative Journey Model that constitutes one focal heroic trajectory with exactly one Protagonist."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "HeroicNarrativeJourneyExecution"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#NarrativeJourneyExecution"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#ConditionDescription",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Normative Description that specifies a condition against which a situation can be assessed."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "ConditionDescription"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#NormativeDescription"
      }
    },
    {
      "@id": "https://w3id.org/ontojourney/core#NormativeDescription",
      "@type": [
        "gufo:SubKind",
        "owl:Class",
        "owl:NamedIndividual"
      ],
      "rdfs:comment": {
        "@language": "en",
        "@value": "A Description that prescribes, permits, or evaluates possible actions or situations instead of merely characterising them."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "NormativeDescription"
      },
      "rdfs:subClassOf": {
        "@id": "https://w3id.org/ontojourney/core#Description"
      }
    },
