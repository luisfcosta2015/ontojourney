    {
      "@id": "https://w3id.org/ontojourney/core#isEncounterOf",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "https://w3id.org/ontojourney/core#ChallengeEncounter"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "isEncounterOf"
      },
