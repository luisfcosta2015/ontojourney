package ontojourney.core

// -----------------------------------------------------------------------------
// Information-bearing objects
// -----------------------------------------------------------------------------

kind InformationObject {
  description { @en "An entity whose identity is determined by its informational content and that may be expressed through different physical or digital carriers." }
}

subkind Description specializes InformationObject {
  description { @en "An Information Object that expresses a conceptualization of entities or configurations and provides criteria for interpreting or assessing them." }
}

subkind NarrativeContent specializes InformationObject {
  description { @en "An Information Object that organises characters, events, or themes as narrative content, independently of the medium through which it is expressed." }
}

subkind NormativeDescription specializes Description {
  description { @en "A Description that prescribes, permits, or evaluates possible actions or situations instead of merely characterising them." }
}

subkind PlanDescription specializes NormativeDescription {
  description { @en "A Normative Description that prescribes or organises intended actions and events towards a purpose." }
}

subkind GoalDescription specializes NormativeDescription {
  description { @en "A Normative Description whose propositional content describes a situation intended to be attained." }
}

subkind ConditionDescription specializes NormativeDescription {
  description { @en "A Normative Description that specifies a condition against which a situation can be assessed." }
}

// -----------------------------------------------------------------------------
// Journey model taxonomy
// -----------------------------------------------------------------------------

// JourneyModel is descriptive. LearningJourneyModel additionally specializes
// PlanDescription because designed educational journeys prescribe activity.

subkind JourneyModel specializes Description {
  description { @en "A Description that characterises a reusable journey pattern through one or more Stage Specifications and one Closure Specification, and may prescribe Intended Transformations." }
}

subkind NarrativeJourneyModel specializes JourneyModel {
  description { @en "A Journey Model whose overall progression is organised by exactly one Journey Narrative." }
}

subkind HeroicNarrativeJourneyModel specializes NarrativeJourneyModel {
  description { @en "A Narrative Journey Model that frames a meaningful progression through demanding stages towards transformation and closure as a heroic trajectory." }
}

subkind LearningJourneyModel specializes JourneyModel, PlanDescription {
  description { @en "A Journey Model and Plan Description that intentionally organises an educational experience and has at least one Educational Purpose." }
}

subkind HeroicNarrativeLearningJourneyModel specializes HeroicNarrativeJourneyModel, LearningJourneyModel {
  description { @en "A Heroic Narrative Journey Model and Learning Journey Model whose identity includes one Journey Narrative, at least two connected Stage Specifications, at least one challenged stage, at least one Educational Purpose, at least one Intended Learning Transformation, and one Closure Specification." }
}

// -----------------------------------------------------------------------------
// Model-level specifications
// -----------------------------------------------------------------------------

subkind StageSpecification specializes PlanDescription {
  description { @en "A Plan Description that specifies one stage belonging to a Journey Model and may be linked to other Stage Specifications through directlyPrecedesStage." }
}

subkind JourneyNarrative specializes NarrativeContent {
  description { @en "Narrative Content that organises the narrative progression of a Narrative Journey Model as a whole." }
}

subkind NarrativeFraming specializes NarrativeContent {
  description { @en "Narrative Content that gives one HLJ Stage Specification its local narrative context and connects it to the wider journey." }
}

subkind IntendedTransformation specializes GoalDescription {
  description { @en "A Goal Description prescribed by a Journey Model that specifies a transformation the model is intended to bring about." }
}

subkind IntendedLearningTransformation specializes IntendedTransformation {
  description { @en "An Intended Transformation that specifies a learning-related change to be pursued through a learning journey." }
}

subkind EducationalPurpose specializes GoalDescription {
  description { @en "A Goal Description that states an educational aim of a Learning Journey Model." }
}

subkind MissionSpecification specializes NormativeDescription {
  description { @en "A Normative Description that states what the Learner is invited or expected to pursue within an HLJ stage and may combine a desired result with directions for action." }
}

subkind ClosureSpecification specializes ConditionDescription {
  description { @en "A Condition Description defined by a Journey Model that states the condition under which an execution of the model counts as having reached closure." }
}

subkind ChallengeSpecification specializes NormativeDescription {
  description { @en "A Normative Description assigned to a Stage Specification that describes a demand, obstacle, problem, task, or condition that makes progression demanding." }
}

subkind AssistanceSpecification specializes NormativeDescription {
  description { @en "A Normative Description of support intended to be made available within an HLJ Stage Specification." }
}

// -----------------------------------------------------------------------------
// Execution taxonomy
// -----------------------------------------------------------------------------

event JourneyExecution {
  description { @en "A complex event in which one Journey Model is enacted in a particular context through one or more Stage Executions." }
}

event NarrativeJourneyExecution specializes JourneyExecution {
  description { @en "A Journey Execution of a Narrative Journey Model in which the performed stages enact a narratively organised journey." }
}

event HeroicNarrativeJourneyExecution specializes NarrativeJourneyExecution {
  description { @en "A Narrative Journey Execution of a Heroic Narrative Journey Model that constitutes one focal heroic trajectory with exactly one Protagonist." }
}

event LearningJourneyExecution specializes JourneyExecution {
  description { @en "A Journey Execution of a Learning Journey Model in which at least one Person participates as Learner." }
}

event HeroicNarrativeLearningJourneyExecution specializes HeroicNarrativeJourneyExecution, LearningJourneyExecution {
  description { @en "A Heroic Narrative Journey Execution and Learning Journey Execution of one Heroic Narrative Learning Journey Model, with exactly one focal Person participating as both Protagonist and Learner." }
}

event SuccessfulHeroicNarrativeLearningJourneyExecution specializes HeroicNarrativeLearningJourneyExecution {
  description { @en "A Heroic Narrative Learning Journey Execution that produces a Closure Situation satisfying the executed model's Closure Specification and at least one Realized Transformation of the focal Person satisfying an Intended Learning Transformation prescribed by that model." }
}

event StageExecution {
  description { @en "An event within a Journey Execution that enacts one Stage Specification belonging to the executed Journey Model." }
}

event HLJStageExecution specializes StageExecution {
  description { @en "A Stage Execution of an HLJ Stage Specification that may include Challenge Encounters, Challenge Performances, and Assistance Provisions connected to specifications of that same stage." }
}

event TransformationEvent {
  description { @en "An event within a Journey Execution that brings about one Realized Transformation." }
}

event ChallengeEncounter {
  description { @en "An event within an HLJ Stage Execution in which the specified challenge of that stage is faced, whether or not it is successfully addressed." }
}

event ChallengePerformance {
  description { @en "An event within an HLJ Stage Execution in which action is directed towards the specified challenge of that stage; its occurrence does not by itself imply success." }
}

event AssistanceProvision {
  description { @en "An event within an HLJ Stage Execution in which assistance specified for that stage is provided." }
}

situation RealizedTransformation {
  description { @en "A situation brought about by one or more Transformation Events that represents an actual change concerning exactly one Person and satisfies one Intended Transformation." }
}

situation ClosureSituation {
  description { @en "A situation brought about by a Journey Execution that satisfies a Closure Specification; in a successful execution, that specification is defined by the executed model." }
}

// -----------------------------------------------------------------------------
// Participants
// -----------------------------------------------------------------------------

kind Person {
  description { @en "A human individual who may participate in Journey Executions and whose identity is preserved across the historical roles Protagonist and Learner." }
}

historicalRole Protagonist specializes Person {
  description { @en "A historical role instantiated by a Person through participation as the focal subject of a Heroic Narrative Journey Execution." }
}

historicalRole Learner specializes Person {
  description { @en "A historical role instantiated by a Person through participation in a Learning Journey Execution." }
}

// -----------------------------------------------------------------------------
// Model structure
// -----------------------------------------------------------------------------

@aggregation relation JourneyModel [1] <>-- hasStage -- [1..*] StageSpecification

// Progression is modeled as a directed graph of stage specifications.
// Branches and cycles are allowed, so the ontology does not impose a
// universal linear order on all journey models.
relation StageSpecification [0..*] -- directlyPrecedesStage -- [0..*] StageSpecification

@aggregation relation NarrativeJourneyModel [1] <>-- hasNarrative -- [1] JourneyNarrative

relation JourneyModel [1] -- prescribesTransformation -- [0..*] IntendedTransformation
relation LearningJourneyModel [1] -- hasEducationalPurpose -- [1..*] EducationalPurpose
relation JourneyModel [1] -- definesClosure -- [1] ClosureSpecification

// -----------------------------------------------------------------------------
// Model execution
// Unique relation names are used to prevent possible IRI collisions during
// RDF/OWL transformation.
// -----------------------------------------------------------------------------

relation JourneyExecution [0..*] -- isExecutionOfJourneyModel -- [1] JourneyModel

@aggregation relation JourneyExecution [1] <>-- hasStageExecution -- [1..*] StageExecution
relation StageExecution [0..*] -- isExecutionOfStageSpecification -- [1] StageSpecification

// -----------------------------------------------------------------------------
// Participation
// -----------------------------------------------------------------------------

// A HeroicNarrativeJourneyExecution represents one focal trajectory and
// therefore has exactly one participating Protagonist.
@participation relation Protagonist [1] -- participatesAsProtagonistIn -- [1..*] HeroicNarrativeJourneyExecution
@participation relation Learner [1..*] -- participatesAsLearnerIn -- [1..*] LearningJourneyExecution

// -----------------------------------------------------------------------------
// Transformation, closure, and successful realization
// -----------------------------------------------------------------------------

@aggregation relation JourneyExecution [1] <>-- hasTransformationEvent -- [0..*] TransformationEvent
@bringsAbout relation TransformationEvent [1..*] -- producesTransformation -- [1] RealizedTransformation
relation RealizedTransformation [0..*] -- satisfiesIntendedTransformation -- [1] IntendedTransformation
relation RealizedTransformation [0..*] -- isTransformationOf -- [1] Person

@bringsAbout relation JourneyExecution [1] -- producesClosure -- [0..1] ClosureSituation
relation ClosureSituation [0..*] -- satisfiesClosureSpecification -- [1] ClosureSpecification

// Cross-path requirements for the successful subtype are operationalized by
// the published SHACL graph.

// -----------------------------------------------------------------------------
// HLJ stage anatomy
// -----------------------------------------------------------------------------

subkind HLJStageSpecification specializes StageSpecification {
  description { @en "A Stage Specification in the Heroine's Learning Journey anatomy that contains exactly one Narrative Framing, Mission Specification, Challenge Specification, and Assistance Specification." }
}

@aggregation relation HLJStageSpecification [1] <>-- hasNarrativeFraming -- [1] NarrativeFraming
@aggregation relation HLJStageSpecification [1] <>-- hasMission -- [1] MissionSpecification
@aggregation relation HLJStageSpecification [1] <>-- hasAssistance -- [1] AssistanceSpecification

// Challenge is available to StageSpecification generally. Additional
// requirements for the HLJ specialization are operationalized in SHACL.
@aggregation relation StageSpecification [1] <>-- hasChallenge -- [0..*] ChallengeSpecification

// -----------------------------------------------------------------------------
// Execution-level realizations of HLJ stage components
// -----------------------------------------------------------------------------

@aggregation relation HLJStageExecution [1] <>-- hasChallengeEncounter -- [0..*] ChallengeEncounter
@aggregation relation HLJStageExecution [1] <>-- hasChallengePerformance -- [0..*] ChallengePerformance
@aggregation relation HLJStageExecution [1] <>-- hasAssistanceProvision -- [0..*] AssistanceProvision

relation ChallengeEncounter [0..*] -- isEncounterOf -- [1] ChallengeSpecification
relation ChallengePerformance [0..*] -- addressesChallenge -- [1] ChallengeSpecification
relation AssistanceProvision [0..*] -- realizesAssistance -- [1] AssistanceSpecification
