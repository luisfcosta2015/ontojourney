<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#ChallengeSpecification">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">ChallengeSpecification</rdfs:label>
    <rdfs:comment xml:lang="en">A Normative Description assigned to a Stage Specification that describes a demand, obstacle, problem, task, or condition that makes progression demanding.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#NormativeDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#IntendedTransformation">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">IntendedTransformation</rdfs:label>
    <rdfs:comment xml:lang="en">A Goal Description prescribed by a Journey Model that specifies a transformation the model is intended to bring about.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#GoalDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#prescribesTransformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">prescribesTransformation</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#JourneyModel"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#IntendedTransformation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#StageSpecification">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">StageSpecification</rdfs:label>
    <rdfs:comment xml:lang="en">A Plan Description that specifies one stage belonging to a Journey Model and may be linked to other Stage Specifications through directlyPrecedesStage.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#PlanDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#participatesAsLearnerIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">participatesAsLearnerIn</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#Learner"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#LearningJourneyExecution"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#participatedIn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasNarrative">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasNarrative</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#NarrativeJourneyModel"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#JourneyNarrative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#NarrativeJourneyModel">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">NarrativeJourneyModel</rdfs:label>
    <rdfs:comment xml:lang="en">A Journey Model whose overall progression is organised by exactly one Journey Narrative.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#JourneyModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#Learner">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Learner</rdfs:label>
    <rdfs:comment xml:lang="en">A historical role instantiated by a Person through participation in a Learning Journey Execution.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#isExecutionOfJourneyModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">isExecutionOfJourneyModel</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#JourneyExecution"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#JourneyModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#isTransformationOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">isTransformationOf</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#RealizedTransformation"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#addressesChallenge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">addressesChallenge</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#ChallengePerformance"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#ChallengeSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#HeroicNarrativeJourneyModel">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HeroicNarrativeJourneyModel</rdfs:label>
    <rdfs:comment xml:lang="en">A Narrative Journey Model that frames a meaningful progression through demanding stages towards transformation and closure as a heroic trajectory.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#NarrativeJourneyModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#ChallengeEncounter">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">ChallengeEncounter</rdfs:label>
    <rdfs:comment xml:lang="en">An event within an HLJ Stage Execution in which the specified challenge of that stage is faced, whether or not it is successfully addressed.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#EducationalPurpose">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">EducationalPurpose</rdfs:label>
    <rdfs:comment xml:lang="en">A Goal Description that states an educational aim of a Learning Journey Model.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#GoalDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#LearningJourneyModel">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">LearningJourneyModel</rdfs:label>
    <rdfs:comment xml:lang="en">A Journey Model and Plan Description that intentionally organises an educational experience and has at least one Educational Purpose.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#JourneyModel"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#PlanDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#TransformationEvent">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">TransformationEvent</rdfs:label>
    <rdfs:comment xml:lang="en">An event within a Journey Execution that brings about one Realized Transformation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#Description">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Description</rdfs:label>
    <rdfs:comment xml:lang="en">An Information Object that expresses a conceptualization of entities or configurations and provides criteria for interpreting or assessing them.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#InformationObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#realizesAssistance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">realizesAssistance</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#AssistanceProvision"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#AssistanceSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#HLJStageExecution">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HLJStageExecution</rdfs:label>
    <rdfs:comment xml:lang="en">A Stage Execution of an HLJ Stage Specification that may include Challenge Encounters, Challenge Performances, and Assistance Provisions connected to specifications of that same stage.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#StageExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasChallengePerformance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasChallengePerformance</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#HLJStageExecution"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#ChallengePerformance"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#InformationObject">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">InformationObject</rdfs:label>
    <rdfs:comment xml:lang="en">An entity whose identity is determined by its informational content and that may be expressed through different physical or digital carriers.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#FunctionalComplex"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#IntendedLearningTransformation">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">IntendedLearningTransformation</rdfs:label>
    <rdfs:comment xml:lang="en">An Intended Transformation that specifies a learning-related change to be pursued through a learning journey.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#IntendedTransformation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasStage</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#JourneyModel"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#StageSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#directlyPrecedesStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">directlyPrecedesStage</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#StageSpecification"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#StageSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#JourneyModel">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">JourneyModel</rdfs:label>
    <rdfs:comment xml:lang="en">A Description that characterises a reusable journey pattern through one or more Stage Specifications and one Closure Specification, and may prescribe Intended Transformations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#Description"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:creator>Luis Felipe Coimbra Costa</dcterms:creator>
    <dcterms:description xml:lang="en">A reference ontology for narrative-heroic learning journeys, modeled in OntoUML and grounded in UFO.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-21</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-08-21</dcterms:modified>
    <dcterms:title xml:lang="en">OntoJourney Core</dcterms:title>
    <vann:preferredNamespacePrefix>oj</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/ontojourney/core#</vann:preferredNamespaceUri>
    <owl:imports rdf:resource="http://purl.org/nemo/gufo#"/>
    <owl:priorVersion rdf:resource="https://w3id.org/ontojourney/core/0.9"/>
    <owl:versionIRI rdf:resource="https://w3id.org/ontojourney/core/0.9.1"/>
    <owl:versionInfo>0.9.1</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#RealizedTransformation">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SituationType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">RealizedTransformation</rdfs:label>
    <rdfs:comment xml:lang="en">A situation brought about by one or more Transformation Events that represents an actual change concerning exactly one Person and satisfies one Intended Transformation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Situation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#producesTransformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">producesTransformation</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#TransformationEvent"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#RealizedTransformation"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#broughtAbout"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#HeroicNarrativeJourneyExecution">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HeroicNarrativeJourneyExecution</rdfs:label>
    <rdfs:comment xml:lang="en">A Narrative Journey Execution of a Heroic Narrative Journey Model that constitutes one focal heroic trajectory with exactly one Protagonist.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#NarrativeJourneyExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#LearningJourneyExecution">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">LearningJourneyExecution</rdfs:label>
    <rdfs:comment xml:lang="en">A Journey Execution of a Learning Journey Model in which at least one Person participates as Learner.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#JourneyExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasStageExecution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasStageExecution</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#JourneyExecution"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#StageExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#NarrativeContent">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">NarrativeContent</rdfs:label>
    <rdfs:comment xml:lang="en">An Information Object that organises characters, events, or themes as narrative content, independently of the medium through which it is expressed.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#InformationObject"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#ChallengePerformance">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">ChallengePerformance</rdfs:label>
    <rdfs:comment xml:lang="en">An event within an HLJ Stage Execution in which action is directed towards the specified challenge of that stage; its occurrence does not by itself imply success.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#MissionSpecification">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">MissionSpecification</rdfs:label>
    <rdfs:comment xml:lang="en">A Normative Description that states what the Learner is invited or expected to pursue within an HLJ stage and may combine a desired result with directions for action.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#NormativeDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#isEncounterOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">isEncounterOf</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#ChallengeEncounter"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#ChallengeSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#NarrativeJourneyExecution">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">NarrativeJourneyExecution</rdfs:label>
    <rdfs:comment xml:lang="en">A Journey Execution of a Narrative Journey Model in which the performed stages enact a narratively organised journey.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#JourneyExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#GoalDescription">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">GoalDescription</rdfs:label>
    <rdfs:comment xml:lang="en">A Normative Description whose propositional content describes a situation intended to be attained.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#NormativeDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#HeroicNarrativeLearningJourneyExecution">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HeroicNarrativeLearningJourneyExecution</rdfs:label>
    <rdfs:comment xml:lang="en">A Heroic Narrative Journey Execution and Learning Journey Execution of one Heroic Narrative Learning Journey Model, with exactly one focal Person participating as both Protagonist and Learner.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#HeroicNarrativeJourneyExecution"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#LearningJourneyExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#Person">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Kind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <rdfs:comment xml:lang="en">A human individual who may participate in Journey Executions and whose identity is preserved across the historical roles Protagonist and Learner.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#FunctionalComplex"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#HeroicNarrativeLearningJourneyModel">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HeroicNarrativeLearningJourneyModel</rdfs:label>
    <rdfs:comment xml:lang="en">A Heroic Narrative Journey Model and Learning Journey Model whose identity includes one Journey Narrative, at least two connected Stage Specifications, at least one challenged stage, at least one Educational Purpose, at least one Intended Learning Transformation, and one Closure Specification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#HeroicNarrativeJourneyModel"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#LearningJourneyModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#NarrativeFraming">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">NarrativeFraming</rdfs:label>
    <rdfs:comment xml:lang="en">Narrative Content that gives one HLJ Stage Specification its local narrative context and connects it to the wider journey.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#NarrativeContent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasChallenge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasChallenge</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#StageSpecification"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#ChallengeSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#isExecutionOfStageSpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">isExecutionOfStageSpecification</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#StageExecution"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#StageSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#JourneyNarrative">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">JourneyNarrative</rdfs:label>
    <rdfs:comment xml:lang="en">Narrative Content that organises the narrative progression of a Narrative Journey Model as a whole.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#NarrativeContent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#SuccessfulHeroicNarrativeLearningJourneyExecution">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">SuccessfulHeroicNarrativeLearningJourneyExecution</rdfs:label>
    <rdfs:comment xml:lang="en">A Heroic Narrative Learning Journey Execution that produces a Closure Situation satisfying the executed model's Closure Specification and at least one Realized Transformation of the focal Person satisfying an Intended Learning Transformation prescribed by that model.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#HeroicNarrativeLearningJourneyExecution"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#Protagonist">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#Role"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">Protagonist</rdfs:label>
    <rdfs:comment xml:lang="en">A historical role instantiated by a Person through participation as the focal subject of a Heroic Narrative Journey Execution.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#Person"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasMission">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasMission</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#HLJStageSpecification"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#MissionSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#JourneyExecution">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">JourneyExecution</rdfs:label>
    <rdfs:comment xml:lang="en">A complex event in which one Journey Model is enacted in a particular context through one or more Stage Executions.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#NormativeDescription">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">NormativeDescription</rdfs:label>
    <rdfs:comment xml:lang="en">A Description that prescribes, permits, or evaluates possible actions or situations instead of merely characterising them.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#Description"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasNarrativeFraming">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasNarrativeFraming</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#HLJStageSpecification"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#NarrativeFraming"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#ClosureSituation">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SituationType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">ClosureSituation</rdfs:label>
    <rdfs:comment xml:lang="en">A situation brought about by a Journey Execution that satisfies a Closure Specification; in a successful execution, that specification is defined by the executed model.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Situation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasAssistance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasAssistance</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#HLJStageSpecification"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#AssistanceSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasChallengeEncounter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasChallengeEncounter</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#HLJStageExecution"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#ChallengeEncounter"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#AssistanceSpecification">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">AssistanceSpecification</rdfs:label>
    <rdfs:comment xml:lang="en">A Normative Description of support intended to be made available within an HLJ Stage Specification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#NormativeDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#HLJStageSpecification">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">HLJStageSpecification</rdfs:label>
    <rdfs:comment xml:lang="en">A Stage Specification in the Heroine's Learning Journey anatomy that contains exactly one Narrative Framing, Mission Specification, Challenge Specification, and Assistance Specification.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#StageSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasTransformationEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasTransformationEvent</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#JourneyExecution"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#TransformationEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#AssistanceProvision">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">AssistanceProvision</rdfs:label>
    <rdfs:comment xml:lang="en">An event within an HLJ Stage Execution in which assistance specified for that stage is provided.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#ConditionDescription">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">ConditionDescription</rdfs:label>
    <rdfs:comment xml:lang="en">A Normative Description that specifies a condition against which a situation can be assessed.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#NormativeDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#PlanDescription">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">PlanDescription</rdfs:label>
    <rdfs:comment xml:lang="en">A Normative Description that prescribes or organises intended actions and events towards a purpose.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#NormativeDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#participatesAsProtagonistIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">participatesAsProtagonistIn</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#Protagonist"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#HeroicNarrativeJourneyExecution"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#participatedIn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#definesClosure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">definesClosure</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#JourneyModel"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#ClosureSpecification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasAssistanceProvision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasAssistanceProvision</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#HLJStageExecution"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#AssistanceProvision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#hasEducationalPurpose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasEducationalPurpose</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#LearningJourneyModel"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#EducationalPurpose"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#ClosureSpecification">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#SubKind"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">ClosureSpecification</rdfs:label>
    <rdfs:comment xml:lang="en">A Condition Description defined by a Journey Model that states the condition under which an execution of the model counts as having reached closure.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/ontojourney/core#ConditionDescription"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#producesClosure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">producesClosure</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#JourneyExecution"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#ClosureSituation"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/nemo/gufo#broughtAbout"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#StageExecution">
    <rdf:type rdf:resource="http://purl.org/nemo/gufo#EventType"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdfs:label xml:lang="en">StageExecution</rdfs:label>
    <rdfs:comment xml:lang="en">An event within a Journey Execution that enacts one Stage Specification belonging to the executed Journey Model.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/nemo/gufo#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#satisfiesIntendedTransformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">satisfiesIntendedTransformation</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#RealizedTransformation"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#IntendedTransformation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/ontojourney/core#satisfiesClosureSpecification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">satisfiesClosureSpecification</rdfs:label>
    <rdfs:domain rdf:resource="https://w3id.org/ontojourney/core#ClosureSituation"/>
    <rdfs:range rdf:resource="https://w3id.org/ontojourney/core#ClosureSpecification"/>
  </rdf:Description>
</rdf:RDF>
