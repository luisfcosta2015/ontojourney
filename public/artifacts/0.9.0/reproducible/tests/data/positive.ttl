@prefix ex: <https://example.org/test#> .
@prefix oj: <https://w3id.org/ontojourney/core#> .

ex:model
    a oj:HeroicNarrativeLearningJourneyModel ;
    oj:hasStage ex:stage1, ex:stage2 ;
    oj:prescribesTransformation ex:intendedTransformation ;
    oj:definesClosure ex:closureSpecification .

ex:stage1
    a oj:HLJStageSpecification ;
    oj:directlyPrecedesStage ex:stage2 ;
    oj:hasChallenge ex:challenge1 .

ex:stage2
    a oj:HLJStageSpecification ;
    oj:hasChallenge ex:challenge2 .

ex:challenge1 a oj:ChallengeSpecification .
ex:challenge2 a oj:ChallengeSpecification .
ex:intendedTransformation a oj:IntendedLearningTransformation .
ex:closureSpecification a oj:ClosureSpecification .

ex:participant
    a oj:Person, oj:Protagonist, oj:Learner ;
    oj:participatesAsProtagonistIn ex:execution ;
    oj:participatesAsLearnerIn ex:execution .

ex:execution
    a oj:SuccessfulHeroicNarrativeLearningJourneyExecution ;
    oj:isExecutionOfJourneyModel ex:model ;
    oj:hasTransformationEvent ex:transformationEvent ;
    oj:producesClosure ex:closure .

ex:transformationEvent
    a oj:TransformationEvent ;
    oj:producesTransformation ex:realizedTransformation .

ex:realizedTransformation
    a oj:RealizedTransformation ;
    oj:satisfiesIntendedTransformation ex:intendedTransformation ;
    oj:isTransformationOf ex:participant .

ex:closure
    a oj:ClosureSituation ;
    oj:satisfiesClosureSpecification ex:closureSpecification .
