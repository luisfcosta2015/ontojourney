@prefix oj: <https://w3id.org/ontojourney/core#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

oj:FocalHeroicExecutionShape
    a sh:NodeShape ;
    sh:targetClass oj:HeroicNarrativeJourneyExecution ;
    sh:property [
        sh:path [ sh:inversePath oj:participatesAsProtagonistIn ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class oj:Protagonist ;
        sh:message "A heroic narrative journey execution must have exactly one focal Protagonist."@en
    ] .

oj:FocalLearningExecutionShape
    a sh:NodeShape ;
    sh:targetClass oj:HeroicNarrativeLearningJourneyExecution ;
    sh:property [
        sh:path [ sh:inversePath oj:participatesAsLearnerIn ] ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class oj:Learner ;
        sh:message "A heroic narrative learning journey execution must have exactly one focal Learner."@en
    ] ;
    sh:sparql [
        sh:message "The focal Protagonist and focal Learner must be the same Person."@en ;
        sh:select """
            PREFIX oj: <https://w3id.org/ontojourney/core#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    ?person oj:participatesAsProtagonistIn $this ;
                            oj:participatesAsLearnerIn $this .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "Every transformation produced within the execution must concern its focal participant."@en ;
        sh:select """
            PREFIX oj: <https://w3id.org/ontojourney/core#>
            SELECT DISTINCT $this
            WHERE {
                $this oj:hasTransformationEvent ?event .
                ?event oj:producesTransformation ?transformation .
                FILTER NOT EXISTS {
                    ?transformation oj:isTransformationOf ?person .
                    ?person oj:participatesAsProtagonistIn $this ;
                            oj:participatesAsLearnerIn $this .
                }
            }
        """
    ] .

oj:RealizedTransformationShape
    a sh:NodeShape ;
    sh:targetClass oj:RealizedTransformation ;
    sh:property [
        sh:path oj:isTransformationOf ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class oj:Person ;
        sh:message "A RealizedTransformation must concern exactly one Person."@en
    ] .

oj:HeroicNarrativeLearningJourneyModelShape
    a sh:NodeShape ;
    sh:targetClass oj:HeroicNarrativeLearningJourneyModel ;
    sh:property [
        sh:path oj:hasStage ;
        sh:minCount 2 ;
        sh:class oj:StageSpecification ;
        sh:message "The model needs two or more StageSpecification members."@en
    ] ;
    sh:property [
        sh:path ( oj:hasStage oj:hasChallenge ) ;
        sh:minCount 1 ;
        sh:class oj:ChallengeSpecification ;
        sh:message "The model needs a hasChallenge path through one of its stages."@en
    ] ;
    sh:sparql [
        sh:message "At least two distinct stages of the model must be connected by directlyPrecedesStage."@en ;
        sh:select """
            PREFIX oj: <https://w3id.org/ontojourney/core#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this oj:hasStage ?first, ?second .
                    ?first oj:directlyPrecedesStage ?second .
                    FILTER (?first != ?second)
                }
            }
        """
    ] .

oj:StageProgressionShape
    a sh:NodeShape ;
    sh:targetSubjectsOf oj:directlyPrecedesStage ;
    sh:sparql [
        sh:message "A Stage Specification must not directly precede itself."@en ;
        sh:select """
            PREFIX oj: <https://w3id.org/ontojourney/core#>
            SELECT $this
            WHERE {
                $this oj:directlyPrecedesStage $this .
            }
        """
    ] ;
    sh:sparql [
        sh:message "Directly related Stage Specifications must belong to at least one common Journey Model."@en ;
        sh:select """
            PREFIX oj: <https://w3id.org/ontojourney/core#>
            SELECT DISTINCT $this
            WHERE {
                $this oj:directlyPrecedesStage ?next .
                FILTER NOT EXISTS {
                    ?model oj:hasStage $this, ?next .
                }
            }
        """
    ] .

oj:HLJStageSpecificationShape
    a sh:NodeShape ;
    sh:targetClass oj:HLJStageSpecification ;
    sh:property [
        sh:path oj:hasChallenge ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class oj:ChallengeSpecification ;
        sh:message "An HLJ Stage Specification must have exactly one Challenge Specification."@en
    ] .

oj:SuccessfulExecutionShape
    a sh:NodeShape ;
    sh:targetClass oj:SuccessfulHeroicNarrativeLearningJourneyExecution ;
    sh:property [
        sh:path oj:isExecutionOfJourneyModel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class oj:HeroicNarrativeLearningJourneyModel ;
        sh:message "A successful execution must execute exactly one heroic narrative learning journey model."@en
    ] ;
    sh:property [
        sh:path oj:producesClosure ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class oj:ClosureSituation ;
        sh:message "A successful execution must produce exactly one Closure Situation."@en
    ] ;
    sh:sparql [
        sh:message "The produced closure must match the closure description linked from the executed model."@en ;
        sh:select """
            PREFIX oj: <https://w3id.org/ontojourney/core#>
            SELECT $this
            WHERE {
                $this oj:isExecutionOfJourneyModel ?model ;
                      oj:producesClosure ?closure .
                FILTER NOT EXISTS {
                    ?closure oj:satisfiesClosureSpecification ?specification .
                    ?model oj:definesClosure ?specification .
                }
            }
        """
    ] ;
    sh:sparql [
        sh:message "A successful execution must realize an intended learning transformation of its focal participant prescribed by the executed model."@en ;
        sh:select """
            PREFIX oj: <https://w3id.org/ontojourney/core#>
            SELECT $this
            WHERE {
                FILTER NOT EXISTS {
                    $this oj:isExecutionOfJourneyModel ?model ;
                          oj:hasTransformationEvent ?event .
                    ?event oj:producesTransformation ?realized .
                    ?realized oj:satisfiesIntendedTransformation ?intended ;
                              oj:isTransformationOf ?person .
                    ?model oj:prescribesTransformation ?intended .
                    ?intended a oj:IntendedLearningTransformation .
                    ?person oj:participatesAsProtagonistIn $this ;
                            oj:participatesAsLearnerIn $this .
                }
            }
        """
    ] .
