@prefix : <https://w3id.org/ontojourney/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/ontojourney/core> a owl:Ontology ;
    dcterms:creator "Luis Felipe Coimbra Costa" ;
    dcterms:description "A reference ontology for narrative-heroic learning journeys, modeled in OntoUML and grounded in UFO."@en ;
    dcterms:issued "2026-08-21"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-08-21"^^xsd:date ;
    dcterms:title "OntoJourney Core"@en ;
    vann:preferredNamespacePrefix "oj" ;
    vann:preferredNamespaceUri "https://w3id.org/ontojourney/core#" ;
    owl:imports gufo: ;
    owl:priorVersion <https://w3id.org/ontojourney/core/0.9> ;
    owl:versionIRI <https://w3id.org/ontojourney/core/0.9.1> ;
    owl:versionInfo "0.9.1" .

:HeroicNarrativeLearningJourneyModel a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HeroicNarrativeLearningJourneyModel"@en ;
    rdfs:comment "A Heroic Narrative Journey Model and Learning Journey Model whose identity includes one Journey Narrative, at least two connected Stage Specifications, at least one challenged stage, at least one Educational Purpose, at least one Intended Learning Transformation, and one Closure Specification."@en ;
    rdfs:subClassOf :HeroicNarrativeJourneyModel,
        :LearningJourneyModel .

:IntendedLearningTransformation a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "IntendedLearningTransformation"@en ;
    rdfs:comment "An Intended Transformation that specifies a learning-related change to be pursued through a learning journey."@en ;
    rdfs:subClassOf :IntendedTransformation .

:SuccessfulHeroicNarrativeLearningJourneyExecution a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "SuccessfulHeroicNarrativeLearningJourneyExecution"@en ;
    rdfs:comment "A Heroic Narrative Learning Journey Execution that produces a Closure Situation satisfying the executed model's Closure Specification and at least one Realized Transformation of the focal Person satisfying an Intended Learning Transformation prescribed by that model."@en ;
    rdfs:subClassOf :HeroicNarrativeLearningJourneyExecution .

:addressesChallenge a owl:ObjectProperty ;
    rdfs:label "addressesChallenge"@en ;
    rdfs:domain :ChallengePerformance ;
    rdfs:range :ChallengeSpecification .

:definesClosure a owl:ObjectProperty ;
    rdfs:label "definesClosure"@en ;
    rdfs:domain :JourneyModel ;
    rdfs:range :ClosureSpecification .

:directlyPrecedesStage a owl:ObjectProperty ;
    rdfs:label "directlyPrecedesStage"@en ;
    rdfs:domain :StageSpecification ;
    rdfs:range :StageSpecification .

:hasAssistance a owl:ObjectProperty ;
    rdfs:label "hasAssistance"@en ;
    rdfs:domain :HLJStageSpecification ;
    rdfs:range :AssistanceSpecification .

:hasAssistanceProvision a owl:ObjectProperty ;
    rdfs:label "hasAssistanceProvision"@en ;
    rdfs:domain :HLJStageExecution ;
    rdfs:range :AssistanceProvision .

:hasChallenge a owl:ObjectProperty ;
    rdfs:label "hasChallenge"@en ;
    rdfs:domain :StageSpecification ;
    rdfs:range :ChallengeSpecification .

:hasChallengeEncounter a owl:ObjectProperty ;
    rdfs:label "hasChallengeEncounter"@en ;
    rdfs:domain :HLJStageExecution ;
    rdfs:range :ChallengeEncounter .

:hasChallengePerformance a owl:ObjectProperty ;
    rdfs:label "hasChallengePerformance"@en ;
    rdfs:domain :HLJStageExecution ;
    rdfs:range :ChallengePerformance .

:hasEducationalPurpose a owl:ObjectProperty ;
    rdfs:label "hasEducationalPurpose"@en ;
    rdfs:domain :LearningJourneyModel ;
    rdfs:range :EducationalPurpose .

:hasMission a owl:ObjectProperty ;
    rdfs:label "hasMission"@en ;
    rdfs:domain :HLJStageSpecification ;
    rdfs:range :MissionSpecification .

:hasNarrative a owl:ObjectProperty ;
    rdfs:label "hasNarrative"@en ;
    rdfs:domain :NarrativeJourneyModel ;
    rdfs:range :JourneyNarrative .

:hasNarrativeFraming a owl:ObjectProperty ;
    rdfs:label "hasNarrativeFraming"@en ;
    rdfs:domain :HLJStageSpecification ;
    rdfs:range :NarrativeFraming .

:hasStage a owl:ObjectProperty ;
    rdfs:label "hasStage"@en ;
    rdfs:domain :JourneyModel ;
    rdfs:range :StageSpecification .

:hasStageExecution a owl:ObjectProperty ;
    rdfs:label "hasStageExecution"@en ;
    rdfs:domain :JourneyExecution ;
    rdfs:range :StageExecution .

:hasTransformationEvent a owl:ObjectProperty ;
    rdfs:label "hasTransformationEvent"@en ;
    rdfs:domain :JourneyExecution ;
    rdfs:range :TransformationEvent .

:isEncounterOf a owl:ObjectProperty ;
    rdfs:label "isEncounterOf"@en ;
    rdfs:domain :ChallengeEncounter ;
    rdfs:range :ChallengeSpecification .

:isExecutionOfJourneyModel a owl:ObjectProperty ;
    rdfs:label "isExecutionOfJourneyModel"@en ;
    rdfs:domain :JourneyExecution ;
    rdfs:range :JourneyModel .

:isExecutionOfStageSpecification a owl:ObjectProperty ;
    rdfs:label "isExecutionOfStageSpecification"@en ;
    rdfs:domain :StageExecution ;
    rdfs:range :StageSpecification .

:isTransformationOf a owl:ObjectProperty ;
    rdfs:label "isTransformationOf"@en ;
    rdfs:domain :RealizedTransformation ;
    rdfs:range :Person .

:participatesAsLearnerIn a owl:ObjectProperty ;
    rdfs:label "participatesAsLearnerIn"@en ;
    rdfs:domain :Learner ;
    rdfs:range :LearningJourneyExecution ;
    rdfs:subPropertyOf gufo:participatedIn .

:participatesAsProtagonistIn a owl:ObjectProperty ;
    rdfs:label "participatesAsProtagonistIn"@en ;
    rdfs:domain :Protagonist ;
    rdfs:range :HeroicNarrativeJourneyExecution ;
    rdfs:subPropertyOf gufo:participatedIn .

:prescribesTransformation a owl:ObjectProperty ;
    rdfs:label "prescribesTransformation"@en ;
    rdfs:domain :JourneyModel ;
    rdfs:range :IntendedTransformation .

:producesClosure a owl:ObjectProperty ;
    rdfs:label "producesClosure"@en ;
    rdfs:domain :JourneyExecution ;
    rdfs:range :ClosureSituation ;
    rdfs:subPropertyOf gufo:broughtAbout .

:producesTransformation a owl:ObjectProperty ;
    rdfs:label "producesTransformation"@en ;
    rdfs:domain :TransformationEvent ;
    rdfs:range :RealizedTransformation ;
    rdfs:subPropertyOf gufo:broughtAbout .

:realizesAssistance a owl:ObjectProperty ;
    rdfs:label "realizesAssistance"@en ;
    rdfs:domain :AssistanceProvision ;
    rdfs:range :AssistanceSpecification .

:satisfiesClosureSpecification a owl:ObjectProperty ;
    rdfs:label "satisfiesClosureSpecification"@en ;
    rdfs:domain :ClosureSituation ;
    rdfs:range :ClosureSpecification .

:satisfiesIntendedTransformation a owl:ObjectProperty ;
    rdfs:label "satisfiesIntendedTransformation"@en ;
    rdfs:domain :RealizedTransformation ;
    rdfs:range :IntendedTransformation .

:ConditionDescription a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ConditionDescription"@en ;
    rdfs:comment "A Normative Description that specifies a condition against which a situation can be assessed."@en ;
    rdfs:subClassOf :NormativeDescription .

:EducationalPurpose a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "EducationalPurpose"@en ;
    rdfs:comment "A Goal Description that states an educational aim of a Learning Journey Model."@en ;
    rdfs:subClassOf :GoalDescription .

:HeroicNarrativeJourneyModel a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HeroicNarrativeJourneyModel"@en ;
    rdfs:comment "A Narrative Journey Model that frames a meaningful progression through demanding stages towards transformation and closure as a heroic trajectory."@en ;
    rdfs:subClassOf :NarrativeJourneyModel .

:HeroicNarrativeLearningJourneyExecution a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HeroicNarrativeLearningJourneyExecution"@en ;
    rdfs:comment "A Heroic Narrative Journey Execution and Learning Journey Execution of one Heroic Narrative Learning Journey Model, with exactly one focal Person participating as both Protagonist and Learner."@en ;
    rdfs:subClassOf :HeroicNarrativeJourneyExecution,
        :LearningJourneyExecution .

:JourneyNarrative a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "JourneyNarrative"@en ;
    rdfs:comment "Narrative Content that organises the narrative progression of a Narrative Journey Model as a whole."@en ;
    rdfs:subClassOf :NarrativeContent .

:Learner a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Learner"@en ;
    rdfs:comment "A historical role instantiated by a Person through participation in a Learning Journey Execution."@en ;
    rdfs:subClassOf :Person .

:MissionSpecification a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "MissionSpecification"@en ;
    rdfs:comment "A Normative Description that states what the Learner is invited or expected to pursue within an HLJ stage and may combine a desired result with directions for action."@en ;
    rdfs:subClassOf :NormativeDescription .

:NarrativeFraming a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "NarrativeFraming"@en ;
    rdfs:comment "Narrative Content that gives one HLJ Stage Specification its local narrative context and connects it to the wider journey."@en ;
    rdfs:subClassOf :NarrativeContent .

:NarrativeJourneyExecution a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "NarrativeJourneyExecution"@en ;
    rdfs:comment "A Journey Execution of a Narrative Journey Model in which the performed stages enact a narratively organised journey."@en ;
    rdfs:subClassOf :JourneyExecution .

:Protagonist a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Protagonist"@en ;
    rdfs:comment "A historical role instantiated by a Person through participation as the focal subject of a Heroic Narrative Journey Execution."@en ;
    rdfs:subClassOf :Person .

:AssistanceProvision a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "AssistanceProvision"@en ;
    rdfs:comment "An event within an HLJ Stage Execution in which assistance specified for that stage is provided."@en ;
    rdfs:subClassOf gufo:Event .

:AssistanceSpecification a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "AssistanceSpecification"@en ;
    rdfs:comment "A Normative Description of support intended to be made available within an HLJ Stage Specification."@en ;
    rdfs:subClassOf :NormativeDescription .

:ChallengeEncounter a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ChallengeEncounter"@en ;
    rdfs:comment "An event within an HLJ Stage Execution in which the specified challenge of that stage is faced, whether or not it is successfully addressed."@en ;
    rdfs:subClassOf gufo:Event .

:ChallengePerformance a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ChallengePerformance"@en ;
    rdfs:comment "An event within an HLJ Stage Execution in which action is directed towards the specified challenge of that stage; its occurrence does not by itself imply success."@en ;
    rdfs:subClassOf gufo:Event .

:ClosureSituation a gufo:SituationType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ClosureSituation"@en ;
    rdfs:comment "A situation brought about by a Journey Execution that satisfies a Closure Specification; in a successful execution, that specification is defined by the executed model."@en ;
    rdfs:subClassOf gufo:Situation .

:ClosureSpecification a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ClosureSpecification"@en ;
    rdfs:comment "A Condition Description defined by a Journey Model that states the condition under which an execution of the model counts as having reached closure."@en ;
    rdfs:subClassOf :ConditionDescription .

:Description a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Description"@en ;
    rdfs:comment "An Information Object that expresses a conceptualization of entities or configurations and provides criteria for interpreting or assessing them."@en ;
    rdfs:subClassOf :InformationObject .

:GoalDescription a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "GoalDescription"@en ;
    rdfs:comment "A Normative Description whose propositional content describes a situation intended to be attained."@en ;
    rdfs:subClassOf :NormativeDescription .

:HeroicNarrativeJourneyExecution a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HeroicNarrativeJourneyExecution"@en ;
    rdfs:comment "A Narrative Journey Execution of a Heroic Narrative Journey Model that constitutes one focal heroic trajectory with exactly one Protagonist."@en ;
    rdfs:subClassOf :NarrativeJourneyExecution .

:InformationObject a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "InformationObject"@en ;
    rdfs:comment "An entity whose identity is determined by its informational content and that may be expressed through different physical or digital carriers."@en ;
    rdfs:subClassOf gufo:FunctionalComplex .

:LearningJourneyExecution a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "LearningJourneyExecution"@en ;
    rdfs:comment "A Journey Execution of a Learning Journey Model in which at least one Person participates as Learner."@en ;
    rdfs:subClassOf :JourneyExecution .

:LearningJourneyModel a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "LearningJourneyModel"@en ;
    rdfs:comment "A Journey Model and Plan Description that intentionally organises an educational experience and has at least one Educational Purpose."@en ;
    rdfs:subClassOf :JourneyModel,
        :PlanDescription .

:NarrativeContent a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "NarrativeContent"@en ;
    rdfs:comment "An Information Object that organises characters, events, or themes as narrative content, independently of the medium through which it is expressed."@en ;
    rdfs:subClassOf :InformationObject .

:NarrativeJourneyModel a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "NarrativeJourneyModel"@en ;
    rdfs:comment "A Journey Model whose overall progression is organised by exactly one Journey Narrative."@en ;
    rdfs:subClassOf :JourneyModel .

:PlanDescription a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "PlanDescription"@en ;
    rdfs:comment "A Normative Description that prescribes or organises intended actions and events towards a purpose."@en ;
    rdfs:subClassOf :NormativeDescription .

:TransformationEvent a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "TransformationEvent"@en ;
    rdfs:comment "An event within a Journey Execution that brings about one Realized Transformation."@en ;
    rdfs:subClassOf gufo:Event .

:ChallengeSpecification a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "ChallengeSpecification"@en ;
    rdfs:comment "A Normative Description assigned to a Stage Specification that describes a demand, obstacle, problem, task, or condition that makes progression demanding."@en ;
    rdfs:subClassOf :NormativeDescription .

:HLJStageExecution a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HLJStageExecution"@en ;
    rdfs:comment "A Stage Execution of an HLJ Stage Specification that may include Challenge Encounters, Challenge Performances, and Assistance Provisions connected to specifications of that same stage."@en ;
    rdfs:subClassOf :StageExecution .

:HLJStageSpecification a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "HLJStageSpecification"@en ;
    rdfs:comment "A Stage Specification in the Heroine's Learning Journey anatomy that contains exactly one Narrative Framing, Mission Specification, Challenge Specification, and Assistance Specification."@en ;
    rdfs:subClassOf :StageSpecification .

:IntendedTransformation a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "IntendedTransformation"@en ;
    rdfs:comment "A Goal Description prescribed by a Journey Model that specifies a transformation the model is intended to bring about."@en ;
    rdfs:subClassOf :GoalDescription .

:Person a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Person"@en ;
    rdfs:comment "A human individual who may participate in Journey Executions and whose identity is preserved across the historical roles Protagonist and Learner."@en ;
    rdfs:subClassOf gufo:FunctionalComplex .

:RealizedTransformation a gufo:SituationType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "RealizedTransformation"@en ;
    rdfs:comment "A situation brought about by one or more Transformation Events that represents an actual change concerning exactly one Person and satisfies one Intended Transformation."@en ;
    rdfs:subClassOf gufo:Situation .

:StageExecution a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "StageExecution"@en ;
    rdfs:comment "An event within a Journey Execution that enacts one Stage Specification belonging to the executed Journey Model."@en ;
    rdfs:subClassOf gufo:Event .

:JourneyExecution a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "JourneyExecution"@en ;
    rdfs:comment "A complex event in which one Journey Model is enacted in a particular context through one or more Stage Executions."@en ;
    rdfs:subClassOf gufo:Event .

:JourneyModel a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "JourneyModel"@en ;
    rdfs:comment "A Description that characterises a reusable journey pattern through one or more Stage Specifications and one Closure Specification, and may prescribe Intended Transformations."@en ;
    rdfs:subClassOf :Description .

:NormativeDescription a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "NormativeDescription"@en ;
    rdfs:comment "A Description that prescribes, permits, or evaluates possible actions or situations instead of merely characterising them."@en ;
    rdfs:subClassOf :Description .

:StageSpecification a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "StageSpecification"@en ;
    rdfs:comment "A Plan Description that specifies one stage belonging to a Journey Model and may be linked to other Stage Specifications through directlyPrecedesStage."@en ;
    rdfs:subClassOf :PlanDescription .

