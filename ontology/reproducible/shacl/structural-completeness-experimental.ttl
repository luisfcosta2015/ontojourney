<https://example.org/ontojourney/audit#addressesChallengeForwardShape> a sh:NodeShape ;
    sh:property [ sh:class <https://w3id.org/ontojourney/core#ChallengeSpecification> ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path <https://w3id.org/ontojourney/core#addressesChallenge> ] ;
    sh:targetClass <https://w3id.org/ontojourney/core#ChallengePerformance> .

<https://example.org/ontojourney/audit#addressesChallengeInverseShape> a sh:NodeShape ;
    sh:property [ sh:class <https://w3id.org/ontojourney/core#ChallengePerformance> ;
            sh:path [ sh:inversePath <https://w3id.org/ontojourney/core#addressesChallenge> ] ] ;
    sh:targetClass <https://w3id.org/ontojourney/core#ChallengeSpecification> .

