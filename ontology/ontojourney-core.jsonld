  {
    "@id": "https://w3id.org/ontojourney/core#JourneyExecution",
    "@type": [
      "http://purl.org/nemo/gufo#EventType",
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
