[
  {
    "@id": "https://w3id.org/ontojourney/core#EducationalPurpose",
    "@type": [
      "http://purl.org/nemo/gufo#SubKind",
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A Goal Description that states an educational aim of a Learning Journey Model."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "EducationalPurpose"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ontojourney/core#GoalDescription"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ontojourney/core#HeroicNarrativeLearningJourneyModel",
    "@type": [
      "http://purl.org/nemo/gufo#SubKind",
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A Heroic Narrative Journey Model and Learning Journey Model whose identity includes one Journey Narrative, at least two connected Stage Specifications, at least one challenged stage, at least one Educational Purpose, at least one Intended Learning Transformation, and one Closure Specification."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "HeroicNarrativeLearningJourneyModel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ontojourney/core#HeroicNarrativeJourneyModel"
      },
      {
        "@id": "https://w3id.org/ontojourney/core#LearningJourneyModel"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ontojourney/core#LearningJourneyModel",
    "@type": [
      "http://purl.org/nemo/gufo#SubKind",
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A Journey Model and Plan Description that intentionally organises an educational experience and has at least one Educational Purpose."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "LearningJourneyModel"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ontojourney/core#JourneyModel"
      },
      {
        "@id": "https://w3id.org/ontojourney/core#PlanDescription"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ontojourney/core#ClosureSituation",
    "@type": [
      "http://purl.org/nemo/gufo#SituationType",
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A situation brought about by a Journey Execution that satisfies a Closure Specification; in a successful execution, that specification is defined by the executed model."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "ClosureSituation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://purl.org/nemo/gufo#Situation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ontojourney/core#NarrativeContent",
    "@type": [
      "http://purl.org/nemo/gufo#SubKind",
      "http://www.w3.org/2002/07/owl#Class",
      "http://www.w3.org/2002/07/owl#NamedIndividual"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An Information Object that organises characters, events, or themes as narrative content, independently of the medium through which it is expressed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "NarrativeContent"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/ontojourney/core#InformationObject"
      }
    ]
  },
  {
    "@id": "https://w3id.org/ontojourney/core#RealizedTransformation",
