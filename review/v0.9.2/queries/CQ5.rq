PREFIX oj: <https://w3id.org/ontojourney/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?execution ?person ?alsoLearner WHERE { ?execution a/rdfs:subClassOf* oj:HeroicNarrativeJourneyExecution . ?person a/rdfs:subClassOf* oj:Person ; oj:participatesAsProtagonistIn ?execution . BIND(EXISTS {?person oj:participatesAsLearnerIn ?execution } AS ?alsoLearner) }
